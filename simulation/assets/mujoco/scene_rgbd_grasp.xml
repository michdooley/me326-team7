<mujoco model="tidybot rgbd grasp scene">
  <include file="tidybot_wx250s_bimanual.xml"/>

  <statistic center="0 0 0.525" extent="1.1" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.85 0.85 0.85" rgb2="0.75 0.75 0.75"
      markrgb="0.9 0.9 0.9" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="red_mat" rgba="0.85 0.15 0.15 1"/>
    <material name="green_mat" rgba="0.15 0.75 0.15 1"/>
    <material name="orange_mat" rgba="0.95 0.55 0.10 1"/>
    <material name="yellow_mat" rgba="0.95 0.90 0.10 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Red cube: world (0.45, -0.10, 0.025) => base_link ~(-0.10, -0.45, 0.025) -->
    <body name="red_cube" pos="0.45 -0.10 0.025">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube_geom" type="box" size="0.025 0.025 0.025" mass="0.1"
        material="red_mat" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>

    <!-- Green sphere: world (0.40, 0.08, 0.02) => base_link ~(0.08, -0.40, 0.02) -->
    <body name="green_sphere" pos="0.40 0.08 0.02">
      <freejoint name="green_sphere_joint"/>
      <geom name="green_sphere_geom" type="sphere" size="0.02" mass="0.08"
        material="green_mat" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>

    <!-- Orange sphere: world (0.50, 0.00, 0.02) => base_link ~(0.00, -0.50, 0.02) -->
    <body name="orange_sphere" pos="0.50 0.00 0.02">
      <freejoint name="orange_sphere_joint"/>
      <geom name="orange_sphere_geom" type="sphere" size="0.02" mass="0.08"
        material="orange_mat" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>

    <!-- Yellow cylinder: world (0.42, -0.05, 0.025) => base_link ~(-0.05, -0.42, 0.025) -->
    <body name="yellow_cylinder" pos="0.42 -0.05 0.025">
      <freejoint name="yellow_cylinder_joint"/>
      <geom name="yellow_cylinder_geom" type="cylinder" size="0.018 0.025" mass="0.1"
        material="yellow_mat" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>
  </worldbody>
</mujoco>
