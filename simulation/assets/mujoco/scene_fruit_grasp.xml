<mujoco model="tidybot fruit grasp scene">
  <include file="tidybot_wx250s_bimanual.xml"/>

  <statistic center="0 0 0.525" extent="1.1" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="flat" rgb1="0.45 0.45 0.45" width="1" height="1"/>
    <material name="groundplane" texture="groundplane" texuniform="true" reflectance="0.0"/>
    <material name="apple_mat" rgba="0.85 0.15 0.15 1"/>
    <material name="orange_mat" rgba="0.95 0.55 0.10 1"/>
    <material name="banana_mat" rgba="0.95 0.90 0.10 1"/>

    <!-- Fruit meshes (centered at origin, scaled to real-world meters) -->
    <mesh name="apple_mesh" file="fruit/apple.stl" scale="0.001 0.001 0.001"/>
    <mesh name="orange_mesh" file="fruit/orange.stl" scale="0.001 0.001 0.001"/>
    <mesh name="banana_mesh" file="fruit/banana.stl" scale="0.019 0.019 0.019"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Apple: world (0.45, -0.10, 0.04) => base_link ~(-0.10, -0.45, 0.04) -->
    <body name="apple" pos="0.45 -0.10 0.04">
      <freejoint name="apple_joint"/>
      <geom name="apple_geom" type="mesh" mesh="apple_mesh" mass="0.2"
        material="apple_mat" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>

    <!-- Orange: world (0.50, 0.00, 0.04) => base_link ~(0.00, -0.50, 0.04) -->
    <body name="orange" pos="0.50 0.00 0.04">
      <freejoint name="orange_joint"/>
      <geom name="orange_geom" type="mesh" mesh="orange_mesh" mass="0.18"
        material="orange_mat" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>

    <!-- Banana: world (0.42, 0.08, 0.025) => base_link ~(0.08, -0.42, 0.025) -->
    <body name="banana" pos="0.42 0.08 0.025">
      <freejoint name="banana_joint"/>
      <geom name="banana_geom" type="mesh" mesh="banana_mesh" mass="0.12"
        material="banana_mat" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>
  </worldbody>
</mujoco>
