<mujoco model="tidybot obstacle scene">
  <include file="tidybot_wx250s_bimanual.xml"/>

  <statistic center="0 0 0.525" extent="1.1" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Obstacle materials -->
    <material name="obstacle_material" rgba="0.5 0.5 0.5 1"/>
    <material name="wall_material" rgba="0.35 0.35 0.35 1"/>
    <material name="red_obstacle_material" rgba="0.8 0.2 0.2 1"/>
    <material name="dark_obstacle_material" rgba="0.3 0.3 0.35 1"/>
    <material name="red_cube_material" rgba="0.85 0.15 0.15 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Border walls (15m x 15m, 0.5m tall) -->
    <geom name="wall_north" type="box" pos="0 7.5 0.25" size="7.5 0.05 0.25" material="wall_material"/>
    <geom name="wall_south" type="box" pos="0 -7.5 0.25" size="7.5 0.05 0.25" material="wall_material"/>
    <geom name="wall_east" type="box" pos="7.5 0 0.25" size="0.05 7.5 0.25" material="wall_material"/>
    <geom name="wall_west" type="box" pos="-7.5 0 0.25" size="0.05 7.5 0.25" material="wall_material"/>

    <!-- ===== Near zone (1-2m from robot) ===== -->

    <!-- Large obstacle blocking the direct path ahead -->
    <body name="obstacle_start_ahead_box" pos="0.0 1.5 0.25">
      <geom name="obstacle_start_ahead_box_geom" type="box" size="0.35 0.35 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_near_left" pos="-1.2 1.0 0.25">
      <geom name="obstacle_near_left_geom" type="box" size="0.20 0.15 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_near_right" pos="1.3 0.8 0.25">
      <geom name="obstacle_near_right_geom" type="cylinder" size="0.22 0.25" material="dark_obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <!-- ===== Mid zone (2.5-4.5m from robot) ===== -->

    <body name="obstacle_mid_box_1" pos="-0.8 3.0 0.25">
      <geom name="obstacle_mid_box_1_geom" type="box" size="0.25 0.20 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_mid_cylinder_1" pos="0.9 2.8 0.25">
      <geom name="obstacle_mid_cylinder_1_geom" type="cylinder" size="0.18 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_mid_wide_1" pos="0.0 3.8 0.25">
      <geom name="obstacle_mid_wide_1_geom" type="box" size="0.40 0.15 0.25" material="dark_obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_mid_box_2" pos="-1.8 3.5 0.25">
      <geom name="obstacle_mid_box_2_geom" type="box" size="0.15 0.25 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_mid_cylinder_2" pos="2.0 3.2 0.25">
      <geom name="obstacle_mid_cylinder_2_geom" type="cylinder" size="0.20 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <!-- Flanking obstacles that create a corridor toward the target -->
    <body name="obstacle_corridor_left" pos="-0.5 4.5 0.25">
      <geom name="obstacle_corridor_left_geom" type="box" size="0.20 0.30 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_corridor_right" pos="0.8 4.8 0.25">
      <geom name="obstacle_corridor_right_geom" type="box" size="0.15 0.25 0.25" material="dark_obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <!-- ===== Target zone: red cube hidden among obstacles ===== -->

    <!-- Obstacles surrounding the target cube -->
    <body name="obstacle_hide_left" pos="-0.3 5.5 0.25">
      <geom name="obstacle_hide_left_geom" type="box" size="0.25 0.20 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_hide_right" pos="0.7 5.3 0.25">
      <geom name="obstacle_hide_right_geom" type="cylinder" size="0.20 0.25" material="dark_obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_hide_behind" pos="0.2 6.0 0.25">
      <geom name="obstacle_hide_behind_geom" type="box" size="0.30 0.15 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <!-- RED CUBE TARGET - hidden among obstacles at ~5.5m from start -->
    <body name="red_cube" pos="0.2 5.5 0.025">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube_geom" type="box" size="0.025 0.025 0.025" mass="0.1"
        material="red_cube_material" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>

    <!-- ===== Far zone (scattered) ===== -->

    <body name="obstacle_far_box_1" pos="-2.5 6.0 0.25">
      <geom name="obstacle_far_box_1_geom" type="box" size="0.20 0.20 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_far_cylinder_1" pos="2.5 5.8 0.25">
      <geom name="obstacle_far_cylinder_1_geom" type="cylinder" size="0.22 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_far_box_2" pos="-1.5 2.0 0.25">
      <geom name="obstacle_far_box_2_geom" type="box" size="0.18 0.18 0.25" material="dark_obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <body name="obstacle_far_cylinder_2" pos="2.8 1.5 0.25">
      <geom name="obstacle_far_cylinder_2_geom" type="cylinder" size="0.15 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- qpos: robot (20) + red_cube freejoint (7) -->
    <key name="scene_home"
      qpos="0 0 1.5708
        0 0
        0 0 0 0 0 0 0.037 0.037
        0 0 0 0 0 0 0.037 0.037
        0.2 5.5 0.025 1 0 0 0"
      ctrl="0 0 1.5708 0 0 0 0 0 0 0 0 0.037 0.037 0 0 0 0 0 0 0.037 0.037"/>
  </keyframe>
</mujoco>
