<mujoco model="tidybot banana test scene">
  <include file="tidybot_wx250s_bimanual.xml"/>

  <statistic center="0 0 0.525" extent="1.1" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.4 0.4 0.4" rgb2="0.35 0.35 0.35"
      markrgb="0.5 0.5 0.5" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>

    <!-- Obstacle materials -->
    <material name="obstacle_material" rgba="0.5 0.5 0.5 1"/>
    <material name="wall_material" rgba="0.35 0.35 0.35 1"/>

    <!-- Fruit meshes -->
    <material name="banana_mat" rgba="0.95 0.90 0.10 1"/>
    <mesh name="banana_mesh" file="fruit/banana.stl" scale="0.019 0.019 0.019"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Border walls (6m x 6m) -->
    <geom name="wall_north" type="box" pos="0 6.05 0.25" size="3.05 0.05 0.25" material="wall_material"/>
    <geom name="wall_south" type="box" pos="0 -1.05 0.25" size="3.05 0.05 0.25" material="wall_material"/>
    <geom name="wall_east"  type="box" pos="3.0 2.5 0.25"  size="0.05 3.55 0.25" material="wall_material"/>
    <geom name="wall_west"  type="box" pos="-3.0 2.5 0.25" size="0.05 3.55 0.25" material="wall_material"/>

    <!-- Single obstacle occluding the banana (~2m ahead, slightly right) -->
    <body name="obstacle_wall" pos="0.3 2.0 0.25">
      <geom name="obstacle_wall_geom" type="box" size="0.50 0.12 0.25" material="obstacle_material"
        mass="10.0" friction="2.0 1.0 1.0"/>
    </body>

    <!-- Banana hidden behind the obstacle (~3m from robot) -->
    <body name="banana" pos="0.3 3.0 0.025">
      <freejoint name="banana_joint"/>
      <geom name="banana_geom" type="mesh" mesh="banana_mesh" mass="0.12"
        material="banana_mat" friction="2.0 1.0 1.0" solref="0.01 1" solimp="0.99 0.99 0.001"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- qpos: robot (21) + 1 fruit freejoint (7) = 28 total -->
    <key name="scene_home"
      qpos="0 0 1.5708
        0 0
        0 0 0 0 0 0 0.037 0.037
        0 0 0 0 0 0 0.037 0.037
        0.3 3.0 0.025 1 0 0 0"
      ctrl="0 0 1.5708 0 0 0 0 0 0 0 0 0.037 0.037 0 0 0 0 0 0 0.037 0.037"/>
  </keyframe>
</mujoco>
